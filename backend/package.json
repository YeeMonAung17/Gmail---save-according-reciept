{
  "name": "backend", "version": "1.0.0", "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env dev.mjs",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2", "@nestjs/core": "12.1.2", "@nestjs/platform-express": "12.1.2",
    "class-transformer": "0.5.1", "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2", "rxjs": "7.8.2"
  },
  "devDependencies": { "@types/express": "5.0.6" }
}
